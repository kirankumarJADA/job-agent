# Copy to frontend/.env.local (git-ignored) and fill in the real values.
#
# These are Vite variables: only names prefixed VITE_ are exposed to the
# browser bundle, which is exactly why the Firebase *service account* must never
# be given a VITE_ prefix.
#
# All six values below are PUBLIC identifiers, not secrets. Firebase's web API
# key and app id are designed to be shipped to the browser; authorisation is
# enforced by Firebase Security Rules and by the backend verifying ID tokens.
# Find them in the Firebase console under:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and config
#
# Until all six are set, the auth screens render an explicit
# "Firebase Authentication is not configured" panel listing what is missing
# instead of failing with an opaque error.

VITE_API_BASE_URL=http://localhost:8080/api/v1

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# NOTE: the backend counterparts (FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL,
# FIREBASE_PRIVATE_KEY) are server-side secrets and belong in the backend's
# environment only. Never prefix them with VITE_ and never commit them.

# ── LOCAL INSPECTION MODE (development only) ────────────────────────────────
# Purpose: Firebase refuses to sign anyone in from an origin that is not
# authorised on the Firebase project (e.g. a Vercel preview domain). When that
# blocks you from looking at the rest of the app locally, this mode signs you in
# as the seeded local development account (`dev@example.local`, seeded by Flyway
# V002/V003) through the ordinary POST /auth/login endpoint — a real backend
# session, so every server-side authentication and authorization check still
# applies. Nothing is faked and no account is created.
#
# Rules:
#   * Leave all three EMPTY (or commented out) except while inspecting locally.
#   * Only ever set them in this git-ignored .env.local, never in Vercel/Render.
#   * The mode additionally requires `npm run dev` (a development build) and an
#     API base URL that is a loopback address.
#   * `npm run build` FAILS — deliberately — if any of the three is set, because
#     a build is deployable and Vite inlines VITE_ values into its output.
#
# The password is the seeded local development password (see the comment at the
# top of backend/src/main/resources/db/migration/V003__fix_seed_user_password.sql).
# It is a local fixture, not a secret to protect — but it must still never be
# committed, and never be used against a deployed environment.
#
# This account exists in a local database only. Migration V024 neutralizes its
# published password in every environment whose profile is not `local`, so a
# deployed backend has nothing to sign in as. The local backend must therefore
# run with SPRING_PROFILES_ACTIVE=local (which infra/docker-compose.yml sets).

# VITE_LOCAL_INSPECTION_MODE=true
# VITE_LOCAL_INSPECTION_EMAIL=dev@example.local
# VITE_LOCAL_INSPECTION_PASSWORD=
