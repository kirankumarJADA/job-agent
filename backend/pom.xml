<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.personal</groupId>
  <artifactId>jobagent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>job-agent-backend</name>
  <description>Personal AI Job Agent — modular monolith backend (Phase 1)</description>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.3.0</archunit.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <firebase-admin.version>9.4.1</firebase-admin.version>
  </properties>

  <dependencies>
    <!-- Core web + validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Redis (cache/locks now, Streams dispatcher in Phase 2) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- Security (session auth, argon2id — implemented P1-b) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!--
      Spring Security's Argon2PasswordEncoder needs Bouncy Castle at
      runtime, but declares it as an OPTIONAL dependency —
      spring-boot-starter-security does NOT pull this in transitively.
      Without it, DaoAuthenticationProvider.retrieveUser() throws
      NoClassDefFoundError on org.bouncycastle.crypto.params.Argon2Parameters$Builder
      on EVERY login attempt (even with correct credentials), because it
      calls Argon2PasswordEncoder.encode() internally for timing-attack
      protection regardless of outcome. Confirmed by a REAL runtime
      failure via docker compose + curl — this was invisible in static
      review/compilation and could only be caught by actually running the
      Spring context, which finally happened in this session.
    -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>

    <!--
      Firebase Admin SDK — server-side verification of Firebase ID tokens
      for the Firebase Authentication flow (signup/sign-in/password reset).

      The SDK is only ever *initialised* when app.firebase.* is fully
      configured; when it is not, FirebaseAuthConfig fails closed and the
      Firebase sign-in endpoint reports "Authentication unavailable"
      instead of starting up a half-configured verifier. Credentials are
      read from environment variables and are never committed.
    -->
    <dependency>
      <groupId>com.google.firebase</groupId>
      <artifactId>firebase-admin</artifactId>
      <version>${firebase-admin.version}</version>
    </dependency>

    <!-- Resilience (circuit breakers for the LLM router, P1-e) -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- API contract-as-code -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>

    <!-- Observability -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>8.0</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <version>4.2.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <!-- 2.0.5: Docker Engine 29 (Docker Desktop 4.52+) raised the minimum
           supported API version to 1.44 and rejects older pinned-version
           requests with HTTP 400. Testcontainers 1.21.x (docker-java 3.x)
           probes with v1.32, so every strategy fails with
           BadRequestException (Status 400) even though the engine is healthy
           (verified via docker info). Testcontainers 2.0.x ships the newer
           docker-java that negotiates >= 1.44. Verified in this session:
           1.21.3 failed against Docker 29.0.1; bumped per the upstream
           compatibility break reported against Testcontainers 1.x. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        Generates META-INF/build-info.properties so /actuator/info reports the
        running artifact's name, version and build time. This works even in
        the Docker build stage (which copies only pom.xml + src, so there is
        no .git there), which is exactly why it is paired with the git plugin
        below rather than relying on git metadata alone.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        Writes git.properties into target/classes so Spring Boot's
        GitInfoContributor can report branch/commit id via /actuator/info.

        Safety choices:
        - includeOnlyProperties keeps the file to exactly the four keys the
          "simple" contributor reads. The plugin's default (full) output also
          writes committer/author name + email, the git remote URL and build
          user/host, none of which belong in a deployed artifact.
        - failOnNoGitDirectory=false: the Docker build stage has no .git, and
          it must not break the build there — it simply omits the git section.
          That means a Docker/Render image only shows the SHA when the build
          context actually contains .git (see docs/DEPLOYMENT.md).
      -->
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>9.0.1</version>
        <executions>
          <execution>
            <id>git-info</id>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
          <includeOnlyProperties>
            <includeOnlyProperty>^git\.branch$</includeOnlyProperty>
            <includeOnlyProperty>^git\.commit\.id$</includeOnlyProperty>
            <includeOnlyProperty>^git\.commit\.id\.abbrev$</includeOnlyProperty>
            <includeOnlyProperty>^git\.commit\.time$</includeOnlyProperty>
          </includeOnlyProperties>
        </configuration>
      </plugin>
      <!--
        Without this, `*IT.java` files (JdbcAuditLogWriterIT, AuthControllerIT,
        OutboxPipelineIT) compile but NEVER RUN. Surefire (the plugin that
        already runs during the `test` phase) only picks up `*Test.java`/
        `Test*.java` by default and silently ignores `*IT.java` — that's the
        whole point of the "IT" naming convention, it signals "this needs
        failsafe, not surefire" (e.g. because it needs Docker/Testcontainers
        and shouldn't run on every quick `mvn test`). Discovered by reading
        `mvn verify` output carefully: it reported BUILD SUCCESS while only
        having actually run ArchModuleBoundaryTest's 4 @ArchTest methods —
        the other three test classes were compiled and then silently skipped.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
