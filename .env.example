# Copy this file to infra/.env (NOT the repo root — Compose looks for .env
# relative to the compose file's directory) before `docker compose up`.
# infra/docker-compose.yml reads these via ${VAR} interpolation.
# Never commit the real infra/.env.

# NVIDIA NIM
NIM_BASE_URL=
NIM_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# ---- Hosted deployment (docs/DEPLOYMENT.md) ----
# Backend (Render) — required, no defaults in the prod profile
# SPRING_DATASOURCE_URL=jdbc:postgresql://<supabase-pooler-host>:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_REDIS_HOST=<upstash-host>
# SPRING_REDIS_PORT=6379
# APP_CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app
# WORKER_EVENT_TOKEN=<openssl rand -hex 32>
# Frontend (Vercel) — set VITE_API_BASE_URL=https://<render-backend>/api/v1

# ---- Production-like local stack (infra/docker-compose.prod-like.yml) ----
# SPRING_DATASOURCE_USERNAME=jobagent
# SPRING_DATASOURCE_PASSWORD=
# SPRING_REDIS_HOST=redis
# SPRING_REDIS_SSL=false
# APP_CORS_ALLOWED_ORIGINS=http://localhost:8081
# WORKER_EVENT_TOKEN=

# Until these are set, /system/llm/ping (added in P1-e) can simulate the
# Gemini provider so the router/circuit-breaker plumbing is testable without
# real keys yet — see validation gate item 4 in the architecture doc.
