# Copy this file to infra/.env (NOT the repo root — Compose reads it there).
# Never commit the real env file or any API key.

# NVIDIA NIM: model IDs are stored in the database registry, never in this URL.
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_API_KEY=

# Optional LLM providers. Automatic routing remains zero-cost only.
GEMINI_API_KEY=
GROQ_API_KEY=

# The application calls NIM_BASE_URL/v1/models when NIM_API_KEY is configured.
# A model is auto-selected only when the catalogue/registry explicitly marks
# it AVAILABLE and free_endpoint=true. Unknown/paid/deprecated entries fail closed.

# ---- Discovery providers (optional) ----
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_TASK_ID=
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io/content
BROWSERLESS_API_TOKEN=
SCRAPERAPI_BASE_URL=https://api.scraperapi.com/
SCRAPERAPI_API_KEY=
SCRAPINGBEE_BASE_URL=https://app.scrapingbee.com/api/v1
SCRAPINGBEE_API_KEY=
LINKEDIN_SEARCH_URL=https://www.linkedin.com/jobs/search/
DISCOVERY_COMPARISON_CONFLICT_THRESHOLD=0.20
DISCOVERY_PRIMARY_CONFIDENCE_THRESHOLD=0.60
DISCOVERY_SECONDARY_PRIORITY=firecrawl,apify,browserless,scraperapi,scrapingbee
DISCOVERY_HTTP_TIMEOUT_MS=15000
DISCOVERY_HTTP_RETRIES=2
DISCOVERY_MAX_PAGES=5
DISCOVERY_ROBOTS_REQUIRED=true

# ---- Hosted deployment ----
# SPRING_DATASOURCE_URL=jdbc:postgresql://<supabase-pooler-host>:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_REDIS_HOST=<upstash-host>
# SPRING_REDIS_PORT=6379
# SPRING_REDIS_PASSWORD=<upstash-token>
# SPRING_REDIS_SSL=true
# APP_CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app
# WORKER_EVENT_TOKEN=<openssl rand -hex 32>
# Frontend: VITE_API_BASE_URL=https://<render-backend>/api/v1
