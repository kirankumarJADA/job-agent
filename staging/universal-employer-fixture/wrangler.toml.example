# Robin synthetic employer portal — Cloudflare Worker configuration TEMPLATE.
#
# This file is deliberately named *.example so that `wrangler deploy` cannot run
# from this directory by accident. Copy it to wrangler.toml ONLY after the
# operator authorisation record exists (see RUNBOOK.md §1). Never commit the
# filled-in copy or any secret.
name = "robin-synthetic-employer-portal"
main = "src/index.js"
compatibility_date = "2024-09-23"

# No *.workers.dev URL: the portal is reachable only on the authorised hostname.
workers_dev = false

# The exact authorised hostname (an operator-owned zone, non-production).
routes = [
  { pattern = "REPLACE-WITH-AUTHORISED-HOSTNAME", custom_domain = true },
]

[vars]
FIXTURE_HOSTNAME = "REPLACE-WITH-AUTHORISED-HOSTNAME"
FIXTURE_PATH_PREFIX = "/robin-fixture"
DATA_TTL_HOURS = "24"

[[durable_objects.bindings]]
name = "FIXTURE_STATE"
class_name = "FixtureState"

[[migrations]]
tag = "v1"
new_classes = ["FixtureState"]

# Secret (set with `wrangler secret put FIXTURE_ADMIN_TOKEN`, >= 32 random chars,
# generated by the operator, never committed, distinct from every Robin secret):
#   FIXTURE_ADMIN_TOKEN
